{
  "name": "study-genius-plus",
  "version": "1.0.0",
  "description": "Study Genius+ Reconstruction",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "node --import tsx apps/server/src/index.ts",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "check:server": "tsc --noEmit -p apps/server/tsconfig.json",
    "test:studio": "node --import tsx --test apps/server/src/studio/generator.test.ts",
    "start": "node --import tsx apps/server/src/index.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --testPathPattern=integration",
    "test:e2e": "echo 'E2E tests not implemented in mock environment'",
    "test:render": "echo 'Render tests not implemented in mock environment'",
    "eval:providers": "echo 'Evaluating providers with real budget...'",
    "verify": "npm run typecheck && npm run test:studio",
    "typecheck": "npm run check:server && npm run build:web",
    "lint": "npm run lint --workspace web"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "smiles-drawer": "^2.4.1",
    "zod": "^4.6.2"
  }
}
